{
  "manifest_version": 3,
  "name": "Temu Wishlist — Lista želja",
  "version": "1.0.0",
  "description": "Spremajte Temu artikle u svoju ličnu wishlistu umjesto u korpu, uz preglednu web listu želja.",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "*://*.temu.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Temu Wishlist",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.temu.com/*"],
      "js": [
        "shared/storage.js",
        "content/temu-extractor.js",
        "content/temu-ui.js"
      ],
      "css": ["content/temu-ui.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
